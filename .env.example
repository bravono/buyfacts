# ==============================================================================
# MinIO S3-Compatible Storage Configuration
# ==============================================================================

# MinIO Server Endpoint URL (include protocol and port, e.g., http://localhost:9000 or http://192.168.1.100:9000)
MINIO_ENDPOINT=http://localhost:9000

# MinIO Access Credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO Bucket Name (must exist in MinIO or be auto-created)
MINIO_BUCKET=uploads

# AWS Region (default for MinIO is us-east-1)
MINIO_REGION=us-east-1

# Optional: MinIO Public Base URL for direct viewing/playing if using a CDN, domain, or reverse proxy.
# Defaults to MINIO_ENDPOINT if omitted.
MINIO_PUBLIC_URL=http://localhost:9000

# Copy this file to .env and fill in the values

DATABASE_URL="file:./prisma/dev.db"
