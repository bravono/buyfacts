// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 1. Core User Identity
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("admin") // e.g. "admin", "user"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// 2. Contact Form (Main Page & Contact Us)
model ContactInquiry {
  id         String   @id @default(uuid())
  name       String
  email      String
  company    String?
  interest   String   @default("General Inquiry")
  message    String
  isEighteen Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// 3. Coming Soon Notification Form
model NotificationSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// 4. Interactive Dashboard Buttons configuration
model DashboardButton {
  id        String   @id @default(uuid())
  label     String
  mediaUrl  String
  mediaType String   @default("video") // e.g. "video", "image", "audio", "pdf"
  subtitle  String?
  category  String   @default("Services") // e.g. "Services", "Thought Leadership"
  color     String? // Optional visual color configuration
  updatedAt DateTime @updatedAt
}

// 5. Uploaded Assets history log
model MediaAsset {
  id         String   @id @default(uuid())
  publicUrl  String
  fileName   String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
}

// 6. ResearchLib / Research Lib Embedded Survey Platform
model ResearchLibSurvey {
  id            Int      @id @default(autoincrement())
  user_id       String   @default("system_default")
  heading       String
  instruction   String
  widget        String
  story         String
  combo         String
  blanks        String   // JSON string of blanks and choices
  durationInMin String?  @default("30")
  pauseDuration String?  @default("3")
  timeCounter   String?  @default("down")
  isFollowup    Int?     @default(1)
  createdAt     DateTime @default(now())

  @@map("research_lib_surveys")
}

model ResearchLibResponse {
  id        Int      @id @default(autoincrement())
  user_id   String
  survey_id Int?
  answers   String   // JSON string of answers
  story     String?
  createdAt DateTime @default(now())

  @@map("research_lib_responses")
}

model ResearchLibTimer {
  id           Int      @id @default(autoincrement())
  user_id      String   @unique
  sessionTimer String?  @default("{}")
  pauseTimer   String?  @default("{}")
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("research_lib_timers")
}

model ResearchLibElement {
  id        Int      @id @default(autoincrement())
  user_id   String   @unique
  state     String?  @default("{}")
  updatedAt DateTime @default(now()) @updatedAt

  @@map("research_lib_elements")
}

model ResearchLibAppState {
  id        Int      @id @default(autoincrement())
  user_id   String   @unique
  state     String?  @default("{}")
  updatedAt DateTime @default(now()) @updatedAt

  @@map("research_lib_app_states")
}

// 7. Cubicon 3D Interactive Survey & Verification Platform
model CubiconTask {
  id                  Int      @id @default(autoincrement())
  taskIndex           Int      @default(0)
  task_number         Int?
  heading             String
  description         String
  screen              String?  @default("")
  image               String
  rotation            String?  @default("left")
  rotation_interval   Int?     @default(15)
  rotationInterval    Int?     @default(15)
  question_type       String?  @default("Selection")
  correct_coordinates String?  @default("")
  start_point         String?  @default("")
  mid_point           String?  @default("")
  end_point           String?  @default("")
  tolerance           Float?   @default(0.5)
  isFinal             Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@map("cubicon_tasks")
}

model CubiconSession {
  id                    Int      @id @default(autoincrement())
  session_id            String   @unique
  taskIndex             Int      @default(0)
  user_email            String?  @default("")
  passedPuzzles         Int      @default(0)
  totalPuzzlesAttempted Int      @default(0)
  previous_result       String?  @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  @@map("cubicon_sessions")
}

model CubiconAttempt {
  id           Int      @id @default(autoincrement())
  session_id   String
  taskIndex    Int
  user_email   String?
  clicks_data  String?  @default("{}")
  start_time   String?
  result       String
  submitted_at DateTime @default(now())

  @@map("cubicon_attempts")
}

model CubiconRegistration {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  role      String?
  interest  String?  @default("Founding Client")
  notes     String?
  createdAt DateTime @default(now())

  @@map("cubicon_registrations")
}

model CubiconShare {
  id            Int       @id @default(autoincrement())
  senderName    String?   @default("")
  senderEmail   String?   @default("")
  receiverName  String?   @default("")
  receiverEmail String?   @default("")
  sharePlatform String?   @default("email")
  shareUrl      String?   @default("")
  sessionId     String?   @default("")
  status        String?   @default("invited")
  createdAt     DateTime? @default(now())

  @@map("cubicon_shares")
}

model FeedbackSubmission {
  id           Int       @id @default(autoincrement())
  userId       String?   @default("")
  userEmail    String?   @default("")
  sessionId    String?   @default("")
  feedbackText String
  rating       Int?      @default(0)
  createdAt    DateTime? @default(now())

  @@map("cubicon_feedback")
}


