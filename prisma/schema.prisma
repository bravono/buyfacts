// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 1. Core User Identity
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("admin") // e.g. "admin", "user"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// 2. Contact Form (Main Page & Contact Us)
model ContactInquiry {
  id         String   @id @default(uuid())
  name       String
  email      String
  company    String?
  interest   String   @default("General Inquiry")
  message    String
  isEighteen Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// 2b. Email Verification Hold Queue (Section 9.1)
model EmailVerification {
  id             String    @id @default(uuid())
  token          String    @unique
  email          String
  type           String    @default("contact") // e.g. "contact", "founding_client", "share"
  payload        String    // JSON string containing submission details held pending verification
  expiresAt      DateTime  // 24 hours from creation
  verifiedAt     DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
}

// 3. Coming Soon Notification Form
model NotificationSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// 4. Interactive Dashboard Buttons configuration
model DashboardButton {
  id        String   @id @default(uuid())
  label     String
  mediaUrl  String
  seeItUrl  String?  // Video link for SEE IT
  hearItUrl String?  // Audio link for HEAR IT
  readItUrl String?  // Document/PDF link for READ IT
  mediaType String   @default("video") // e.g. "video", "image", "audio", "pdf"
  subtitle  String?
  category  String   @default("Services") // e.g. "Services", "Thought Leadership"
  color     String?  // Optional visual color configuration
  updatedAt DateTime @updatedAt
}

// 5. Uploaded Assets history log
model MediaAsset {
  id         String   @id @default(uuid())
  publicUrl  String
  fileName   String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
}

// 6. ResearchLib / Research Lib Embedded Survey Platform
model ResearchLibSurvey {
  id            Int      @id @default(autoincrement())
  userId        String   @default("system_default")
  heading       String
  instruction   String
  widget        String
  story         String
  combo         String
  blanks        String   // JSON string of blanks and choices
  durationInMin String?  @default("30")
  pauseDuration String?  @default("3")
  timeCounter   String?  @default("down")
  isFollowup    Int?     @default(1)
  createdAt     DateTime @default(now())
}

model ResearchLibResponse {
  id        Int      @id @default(autoincrement())
  userId    String
  surveyId  Int?
  answers   String   // JSON string of answers
  story     String?
  createdAt DateTime @default(now())
}

model ResearchLibTimer {
  id           Int      @id @default(autoincrement())
  userId       String   @unique
  sessionTimer String?  @default("{}")
  pauseTimer   String?  @default("{}")
  updatedAt    DateTime @default(now()) @updatedAt
}

model ResearchLibElement {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  state     String?  @default("{}")
  updatedAt DateTime @default(now()) @updatedAt
}

model ResearchLibAppState {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  state     String?  @default("{}")
  updatedAt DateTime @default(now()) @updatedAt
}

// 7. Cubicon 3D Interactive Survey & Verification Platform
model CubiconSequence {
  id                     Int              @id @default(autoincrement())
  slug                   String           @unique
  title                  String
  description            String?          @default("")
  passThreshold          Float?           @default(0.66)
  rotationDirection      String?          @default("left")
  defaultRotationInterval Int?            @default(15)
  isActive               Boolean?         @default(true)
  createdBy              String?          @default("system")
  createdAt              DateTime?        @default(now())
  updatedAt              DateTime?        @default(now()) @updatedAt
  tasks                  CubiconTask[]
  sessions               CubiconSession[]
  attempts               CubiconAttempt[]
}

model CubiconTask {
  id                 Int              @id @default(autoincrement())
  sequenceId         Int?
  sequence           CubiconSequence? @relation(fields: [sequenceId], references: [id])
  taskIndex          Int              @default(0)
  taskNumber         Int?
  heading            String
  description        String
  screen             String?          @default("")
  image              String
  rotation           String?          @default("left")
  rotationInterval   Int?             @default(15)
  questionType       String?          @default("Selection")
  correctCoordinates String?          @default("")
  startPoint         String?          @default("")
  midPoint           String?          @default("")
  endPoint           String?          @default("")
  tolerance          Float?           @default(0.5)
  isFinal            Boolean          @default(false)
  createdAt          DateTime         @default(now())
}

model CubiconSession {
  id                    Int              @id @default(autoincrement())
  sessionId             String           @unique
  sequenceId            Int?
  sequence              CubiconSequence? @relation(fields: [sequenceId], references: [id])
  taskIndex             Int              @default(0)
  userEmail             String?          @default("")
  passedPuzzles         Int              @default(0)
  totalPuzzlesAttempted Int              @default(0)
  previousResult        String?          @default("")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt
}

model CubiconAttempt {
  id          Int              @id @default(autoincrement())
  sessionId   String
  sequenceId  Int?
  sequence    CubiconSequence? @relation(fields: [sequenceId], references: [id])
  taskIndex   Int
  userEmail   String?
  clicksData  String?          @default("{}")
  startTime   String?
  result      String
  submittedAt DateTime         @default(now())
}

model CubiconRegistration {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  role      String?
  interest  String?  @default("Founding Client")
  notes     String?
  isUsBased Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CubiconShare {
  id            Int       @id @default(autoincrement())
  senderName    String?   @default("")
  senderEmail   String?   @default("")
  receiverName  String?   @default("")
  receiverEmail String?   @default("")
  sharePlatform String?   @default("email")
  shareUrl      String?   @default("")
  sessionId     String?   @default("")
  status        String?   @default("invited")
  createdAt     DateTime? @default(now())
}

model FeedbackSubmission {
  id           Int       @id @default(autoincrement())
  userId       String?   @default("")
  userEmail    String?   @default("")
  sessionId    String?   @default("")
  feedbackText String
  rating       Int?      @default(0)
  createdAt    DateTime? @default(now())
}

enum ContentFormat {
  ARTICLE
  VIDEO
  PDF
  AUDIO
}

model VaultAsset {
  id           String        @id @default(cuid())
  title        String
  description  String?
  format       ContentFormat
  sourceUrl    String?
  embedCode    String?
  topicId      String
  topic        Topic         @relation(fields: [topicId], references: [id])
  keywords     String        // Stored as JSON string or comma-separated string for SQLite compatibility
  isPublished  Boolean       @default(true)
  publishedAt  DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([publishedAt(sort: Desc)])
  @@index([format])
  @@index([topicId])
}

model Topic {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  category    String
  assets      VaultAsset[]
  createdAt   DateTime     @default(now())
}

