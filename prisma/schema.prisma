// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 1. Core User Identity
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

// 2. Contact Form (Main Page & Contact Us)
model ContactInquiry {
  id         String   @id @default(uuid())
  name       String
  email      String
  company    String?
  interest   String   @default("General Inquiry")
  message    String
  isEighteen Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// 3. Coming Soon Notification Form
model NotificationSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// 4. Interactive Dashboard Buttons configuration
model DashboardButton {
  id        String   @id @default(uuid())
  label     String
  mediaUrl  String
  mediaType String   @default("video") // e.g. "video", "image", "audio", "pdf"
  subtitle  String?
  category  String   @default("Services") // e.g. "Services", "Thought Leadership"
  color     String? // Optional visual color configuration
  updatedAt DateTime @updatedAt
}

// 5. Uploaded Assets history log
model MediaAsset {
  id         String   @id @default(uuid())
  publicUrl  String
  fileName   String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
}
