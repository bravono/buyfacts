// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 1. Core User Identity
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

// 2. Contact Form (Main Page & Contact Us)
model ContactInquiry {
  id         String   @id @default(uuid())
  name       String
  email      String
  company    String?
  interest   String   @default("General Inquiry")
  message    String
  isEighteen Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// 3. Coming Soon Notification Form
model NotificationSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// 4. Interactive Dashboard Buttons configuration
model DashboardButton {
  id        String   @id @default(uuid())
  label     String
  mediaUrl  String
  mediaType String   @default("video") // e.g. "video", "image", "audio", "pdf"
  subtitle  String?
  category  String   @default("Services") // e.g. "Services", "Thought Leadership"
  color     String? // Optional visual color configuration
  updatedAt DateTime @updatedAt
}

// 5. Uploaded Assets history log
model MediaAsset {
  id         String   @id @default(uuid())
  publicUrl  String
  fileName   String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
}

// 6. ResearchLib / Research Lib Embedded Survey Platform
model ResearchLibSurvey {
  id            Int      @id @default(autoincrement())
  user_id       String   @default("system_default")
  heading       String
  instruction   String
  widget        String
  story         String
  combo         String
  blanks        String   // JSON string of blanks and choices
  durationInMin String?  @default("30")
  pauseDuration String?  @default("3")
  timeCounter   String?  @default("down")
  isFollowup    Int?     @default(1)
  createdAt     DateTime @default(now())

  @@map("research_lib_surveys")
}

model ResearchLibResponse {
  id        Int      @id @default(autoincrement())
  user_id   String
  survey_id Int?
  answers   String   // JSON string of answers
  story     String?
  createdAt DateTime @default(now())

  @@map("research_lib_responses")
}

model ResearchLibTimer {
  id           Int      @id @default(autoincrement())
  user_id      String   @unique
  sessionTimer String?  @default("{}")
  pauseTimer   String?  @default("{}")
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("research_lib_timers")
}

model ResearchLibElement {
  id        Int      @id @default(autoincrement())
  user_id   String   @unique
  state     String?  @default("{}")
  updatedAt DateTime @default(now()) @updatedAt

  @@map("research_lib_elements")
}

model ResearchLibAppState {
  id        Int      @id @default(autoincrement())
  user_id   String   @unique
  state     String?  @default("{}")
  updatedAt DateTime @default(now()) @updatedAt

  @@map("research_lib_app_states")
}

